# @plugin(@varlock/1password-plugin)
# @currentEnv=$APP_ENV
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(dev))
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ---

# @type=opServiceAccountToken @sensitive
OP_TOKEN=

# @type=enum(dev, prod)
APP_ENV=dev
LANGSMITH_PROJECT=op(`op://langchain/public/LANGSMITH_PROJECT`)
# @type=boolean
LANGSMITH_TRACING=op(`op://langchain/public/LANGSMITH_TRACING`)
# @type=url
LANGSMITH_ENDPOINT=op(`op://langchain/public/LANGSMITH_ENDPOINT`)

# @sensitive
LANGSMITH_API_KEY=op(`op://langchain/private/LANGSMITH_API_KEY`)
# @sensitive
OPENAI_API_KEY=op(`op://langchain/private/OPENAI_API_KEY`)
# @sensitive
TAVILI_API_KEY=op(`op://langchain/private/TAVILI_API_KEY`)